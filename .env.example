# Prefer Settings (orb menu) for everything here: it keeps the API key in your Keychain.
# Anything set in this file overrides Settings (ADR 0015).
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# MARGINALIA_MODEL=claude-opus-5-5
# MARGINALIA_EFFORT=medium           # low is faster, high digs deeper
# MARGINALIA_HIRES=0                  # 1 only for models on the high-resolution image tier
# MARGINALIA_HOTKEY=<ctrl>+<alt>+<space>
# MARGINALIA_VOICE_HOTKEY=<ctrl>+<alt>+v   # hold to talk; tap to talk until you pause
# MARGINALIA_OCR=1
# MARGINALIA_LOG_DIR=~/Marginalia
# MARGINALIA_USER_CONTEXT=The user is a graduate researcher in quantum information...
# MARGINALIA_VOICE=1
# MARGINALIA_WHISPER_MODEL=base.en   # tiny.en is faster, small.en more accurate
# MARGINALIA_SAVE_CASES=0            # 1 saves each question as an unlabelled eval case in ~/Marginalia/cases
# MARGINALIA_LOG_LEVEL=info          # console detail; <log dir>/logs/marginalia.jsonl always keeps everything
# MARGINALIA_CRASH_REPORTS=0         # 1 offers to report the last crash as a GitHub issue you review first
