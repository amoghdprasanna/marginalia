<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime (required for notarisation) blocks the microphone unless asked for here. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- ctypes callbacks (Carbon hotkeys) are libffi closures in writable+executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Python extension modules and Qt plugins are loaded as separately signed libraries. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
